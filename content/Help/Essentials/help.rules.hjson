{
	$version: "0.1.71.1"
	name: "00: Rules"
	category: "00: Essentials"
	desc:
		'''
		Server hosts may modify these rules, but this is a general outline for expected behaviour.
		'''
	
	order: 0
	size: [456, 0]
	layout: a
	flags: none
	
	title: "Rules"
	sprite_scale: 6
	sprite:
	{
		texture: ui_icons_widget
		size: [16, 16]
		frame: [3, 2]
	}
	entries:
	[
		{
			text: "Rules:"
			color: "0xfffff0d8"
			flags: bold
		}
		{
			text: "Hosts may override these rules if desired."
			color: "0xfffff0d8"
			flags: bullet
		}
		{
			text: "Offlining is allowed, starting fights without warning is allowed. Unbalanced fights are allowed but discouraged."
			color: "0xfffff0d8"
			flags: bullet
		}
		{
			text: "Avoid excessive spawncamping. If a spawn is in your base, that's fine, but don't go out of your way to control every spawn."
			color: "0xfffff0d8"
			flags: bullet
		}
		{
			text: "Avoid gamebreaking exploits. Minor exploits are fine, just don't expect them to stay forever. Report issues with the engine and core content to TFlippy, and Legacy issues to neobind."
			color: "0xfffff0d8"
			flags: bullet
		}
	]
}