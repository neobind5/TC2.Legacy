{
	$version: "0.1.72.1"
	name: "Outpost"
	desc:
		'''
		Small faction outpost.
		'''
	tips:
	[
		"Can be respawned at"
		"Provides a small storage"
		"Access to faction management"
	]
	
	stages:
	[
		{
			name: "Foundation"
			
			type: foundation
			flags: wip
			tags: none
			// Damage type used for discarding leftover resources.
			discard_damage_type: shovel
			
			options:
			[
				{
					name: "Niklajzner"
					
					type: undefined
					flags: wip
					discard_damage_type_override: drill
					
					requirements:
					[
						{
							type: resource
							material: niklajzner
							amount: 80.000
							snapping: 1.000
							group: 0
							flags: primary
						}
						{
							type: work
							work: hammering
							amount: 60.000
							group: 1
							flags: conditional
						}
					]
				}
			]
		}
		{
			name: "Furniture"
			
			type: infrastructure
			flags: wip
			tags: none
			// Damage type used for discarding leftover resources.
			discard_damage_type: axe
			
			options:
			[
				{
					name: "Standard"
					
					type: undefined
					flags: wip
					
					requirements:
					[
						{
							type: resource
							material: steel.frames
							amount: 8.000
							snapping: 0.500
							loss: 0.075
							group: 0
						}
						{
							type: resource
							material: steel.plate
							amount: 25.000
							snapping: 0.500
							loss: 0.122
							group: 0
						}
						{
							type: resource
							material: wood
							amount: 20.000
							snapping: 5.000
							loss: 0.075
							group: 0
						}
						{
							type: work
							work: carpentry
							amount: 400.000
							difficulty: 6
							snapping: 5.000
							group: 0
							flags: conditional
						}
					]
				}
			]
		}
	]
	
	products:
	[
		{
			type: prefab
			prefab: outpost.built.00
			amount: 1.000
			group: 0
			flags: primary, hidden
		}
	]
	
	type: buildings
	flags: no_amount_multiplier, construction, building, ignore_tools, ignore_equipment, ignore_machinery, ignore_environment, no_cancel, auto_complete
	tags: simple, metalworking, construction
	hints: none
	
	icon:
	{
		texture: outpost.00
		size: [40, 40]
	}
	
	color_frame: "0xffff5f11"
	color_button: "0xff9dd80f"
	button_name: "Build"
	rank: -800.000
	
	min: 1
	max: 1
	step: 1
	
	placement:
	{
		type: simple
		flags: allow_mirror_x
		
		size: [5.000, 5.000]
		offset: [0.000, -1.500]
		
		rect_foundation: [-2.500, 0.000, 2.500, 1.000]
		tileflags_foundation: solid
		
		rect_clearance: [-2.125, -3.500, 2.125, 0.000]
		tileflags_clearance: solid
		
		cooldown: 1.000
		min_support: 0.5
		min_clearance: 0.7
		min_claim: 1.000
		
		rotation_max: 0.200
		
		sound: building_place
		
		snapping_filter:
		{
			include: world
			exclude: construction, dynamic
		}
		snapping_flags: snap_to_surface, use_raw_collider, no_end_snap
		snapping_radius: 0.500
		
		mappings_replace:
		{
		
		}
	}
	
	construction:
	{
		prefab: construction.5x5
		
		requirements:
		[
			{
				type: resource
				material: wood
				amount: 20.000
				loss: 0.110
				group: 0
				flags: compact, no_scaling, prerequisite
			}
		]
	}
	
	h_sound_finalize: building_construct
	
	version: 1
}