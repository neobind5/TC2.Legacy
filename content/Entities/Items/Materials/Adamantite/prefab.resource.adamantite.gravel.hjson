$tags: []

body:
{
	buoyancy: 0.010

	@shape.circle:
	{
		offset: [0.000, 0.250]
		mass: 1.000
		radius: 0.750
		friction: 0.650
		elasticity: 0.500
		material: gravel
		layer: entity, solid, resource, ignore_melee, ignore_bullet
		mask: world, essence
	}
}

animated.renderer:
{
	sprite:
	{
		texture: "resource.adamantite.gravel"
		count: 4
		size: [16, 16]
	}
	@sound.emitter:
	{
		file: effect.flow.oil.loop.00
		flags: none
		volume: 3.000
		pitch: 0.100
		size: 0.100
		size_max_modifier: 0.500
		priority: 0.100
		offset: [0.000, 0.500]
	}
}

transform:
{

}

resource:
{
	material: "adamantite.gravel"
}

holdable:
{
	force_multiplier: 1.800
	torque_multiplier: 0.700
	offset: [0.000, 0.750]
}

norotate:
{

}