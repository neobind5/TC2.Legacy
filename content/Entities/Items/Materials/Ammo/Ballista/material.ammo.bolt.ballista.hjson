{
	$version: "0.1.75.1"
	name: "Ballista Bolts"
	name_short: "Ballista Bolts"
	description:
		'''
		Irregular oversized wooden arrowbolts.

		Cleverly designed by denizens in order to streamline plundering and mischief.
		'''
	
	tips: []
	
	icon:
	{
		texture: resource.ammo.bolt.ballista
		size: [16, 16]
		frame: [3, 0]
	}
	
	// Inventory material type.
	type: bramble
	flags: ammo, ammo_harpoon, soft, long, thin, manufactured, flammable, flexible, solid
	display_flags: hide_fraction
	spawn_flags:
	{
		add: no_discard
	}
	hints: primitive, weak, long, thin, cheap, civilian
	
	// Ratio of the material volume to the total volume it occupies when stacked. A value of 1.0 means no empty space, while a value closer to 0.0 means a lot of empty space.
	packing_fraction: 0.000
	// Mass of 1 unit in kg.
	mass_per_unit: 0.800
	
	// Maximum quantity (units) per stack.
	quantity_max: 8.000
	// Minimum spawnable quantity.
	spawn_quantity_threshold: 1.000
	// Preferred quantity snapping for recipes.
	snapping: 1.000
	// Preferred quantity snapping for inventories.
	snapping_pickup: 1.000
	
	prefab: resource.ammo.bolt.ballista
	
	color_icon: "0xffffffff"
	color_item: "0xffffffff"
	color_dust: "0xffffffff"
	color_gib: "0xffffffff"
	
	colliders: []
	
	commodity:
	{
		flags: none
		categories: weapons, toys
		
		market_price: 12.000
		market_price_per_kg_auto: 25.000
	}
	
	ammo:
	{
		count: 1
		mass: 12.400
		heat: 0.000
		velocity_min: 4.500
		
		speed_base: 0.000
		speed_mult: 3.000
		speed_jitter: 0.020
		spin_base: 0.020
		spin_mult: 1.000
		spread_mult: 1.000
		recoil_mult: 3.000
		
		failure_base: 0.000
		failure_mult: 1.000
		
		stability_base: 10.000
		stability_mult: 1.000
		
		prefab: projectile.bolt.ballista
	}
}