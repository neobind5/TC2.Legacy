$name: "Toolbox"
$desc: 
	'''
	Toolbox for holding all of your tools. You can also beat people to death with it.
	'''
$tags: []

body:
{
	type: dynamic
	flags: none
	
	fall_damage_multiplier: 1.000

	@shape.line:
	{
		a: [-0.250, 0.000]
		b: [0.250, 0.000]
		offset: [0.000, 0.150]
		
		mass: 8.500
		radius: 0.4375
		friction: 0.920
		elasticity: 0.750
		
		material: metal
		miss_chance: 0.000
		
		layer: entity, solid, item, ignore_melee, ignore_bullet
		mask: world
		exclude: none
	}
}

health:
{
	max: 6500.000
}

control:
{

}

holdable:
{
	offset: [-0.250, 0.000]
	flags: storable
}

shipment:
{
	flags: allow_withdraw, allow_deposit, public, no_empty_deposit, cached
	type: pouch
	layout: square
	h_container: pouch.00
	
	items:
	[
		{
			type: prefab
			prefab: wrench.00
			quantity: 1.000
			flags: none
		}
		{
			type: prefab
			prefab: handsaw.00
			quantity: 1.000
			flags: none
		}
		{
			type: prefab
			prefab: sledgehammer.00
			quantity: 1.000
			flags: none
		}
		{
			type: prefab
			prefab: pickaxe.00
			quantity: 1.000
			flags: none
		}
	]
}

melee:
{
	damage_base: 120.000
	damage_bonus: 150.000
	
	terrain_damage_multiplier: 0.800
	pain_multiplier: 1.100
	stun_multiplier: 1.800
	
	disarm_chance: 0.370
	cooldown: 1.000
	max_distance: 0.900
	aoe: 1.000
	thickness: 0.925
	knockback: 700.000
	yield: 0.900
	penetration_falloff: 0.280
	penetration: 0.7
	
	hit_offset: [0.125, -0.750]
	
	swing_offset: [0.500, 0.875]
	swing_rotation: -2.000
	
	sound_volume: 1.000
	sound_size: 1.500
	sound_pitch: 0.440
	
	damage_type: sledgehammer
	category: blunt
	flags: friendly_fire
	
	damage_flags_add: no_loot_discard, force_loot_notification
	damage_flags_rem: no_loot_notification
	
	hit_mask: world, destructible
	hit_exclude: background, water, fire, gas, powder, liquid, stored
	hit_ignore: water, fire, gas, powder, liquid, stored
}

animated.renderer:
{
	sprite:
	{
		texture: toolbox.00
	}
	scale: [0.875, 0.875]
}

transform:
{

}

packable:
{

}

interactable:
{
	flags: no_tab, centered_inventory
	window_size: [96.000, 96.000]
	window_size_min: [96.000, 96.000]
}

norotate:
{
	bias: 0.001
	speed: 3.000
	multiplier: 1.000
	mass_multiplier: 10.000
}