$name: "Ballista"
$desc:
	'''
	The crossbow's older cousin.
	
	Not very fun at parties, but brings good food!
	'''
$tags: []

body:
{
	@shape.line:
	{
		a: [-0.800, 0.000]
		b: [0.800, 0.000]
		mass: 150.000
		radius: 0.6
		friction: 0.600
		elasticity: 0.650
		material: wood
		layer: entity, solid, flammable
		mask: world
	}
}

control:
{

}

aimable:
{
	min: -1.800
	max: 1.800
}

gun:
{
	muzzle_offset: [0.875, -0.125]
	receiver_offset: [0.000, -0.250]
	
	sound_volume: 0.550
	sound_size: 0.625
	sound_dist_multiplier: 0.640
	sound_pitch: 1.270
	
	sound_shoot: crossbow_shoot
	sound_cycle: item.adjust.02
	sound_reload: effect.spring.machine.01
	sound_jam: gun_jam
	
	damage_multiplier: 3.850
	velocity_multiplier: 95.000
	jitter_multiplier: 0.040
	recoil_multiplier: 0.100
	velocity_max: 160.000
	reload_interval: 8.700
	cycle_interval: 0.300
	
	ammo_filter: ammo_harpoon
	max_ammo: 1.000
	
	action: manual
	type: launcher
	feed: single
	
	flags: full_reload, no_particles
	heuristic_range: 22.000

	@inventory1:
	{
		type: ammo
		flags: hidden, ignore_mass, no_auto_pickup
		stack_size_multiplier: 1.000
		
		filter:
		{
			require: ammo_harpoon
			exclude: gas
		}
		offset: [0.000, -0.250]
	}
}

attachment:
{
	force_multiplier: 10.000
	offset: [0.000, 0.000]
	flags: mirror_rotate, full_rotate
	tags: medium, large, weapon, rotary, long, gun
}

gun.state:
{

}

holdable:
{
	offset: [-0.250, -0.125]
	force_multiplier: 0.800
	torque_multiplier: 0.600
	hints: weapon, gun, usable
}

animated.renderer:
{
	sprite:
	{
		texture: "ballista.00"
	}
}

transform:
{

}

packable:
{

}