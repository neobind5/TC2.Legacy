$name: "The Big One (Large, Impact)"
$desc:
	'''
	Ultimate weapon of destruction. Extremely heavy.
	'''
$tags: []

control:
{

}

body:
{
	@shape.circle:
	{
		mass: 3250.500
		radius: 2.600
		friction: 0.500
		elasticity: 0.100
		material: metal
		layer: entity, solid, flammable
		mask: world
	}
	@shape.line:
	{
		a: [-2.500, 2.275]
		b: [2.500, 2.275]
		offset: [0.000, 0.000]
		scale: [1.000, 1.000]
		mass: 850.500
		radius: 0.350
		friction: 0.500
		elasticity: 0.100
		material: metal
		layer: entity, solid, flammable
		mask: world
	}
	fall_damage_multiplier: 22.000
	gravity: 1.85
}

health:
{
	max: 6900.000
}

norotate:
{
	speed: 3.000
	multiplier: 0.750
	mass_multiplier: 15.000
	attached_multiplier: 0.300
	flags: no_share
}

holdable:
{
	offset: [0.000, 0.000]
}

animated.renderer:
{
	sprite:
	{
		texture: "bomb.nuke.large"
	}
	offset: [0.000, -0.250]
}

transform:
{

}

explosive:
{
	radius: 20.000
	power: 25.000
	damage_entity: 92000.000
	damage_terrain: 64500.000
    primed_threshold: 0.888
	smoke_amount: 5.800
	sparks_amount: 3.500
	smoke_lifetime_multiplier: 0.700
	smoke_velocity_multiplier: 1.800
	flash_duration_multiplier: 3.250
	flash_intensity_multiplier: 0.800
	smoke_color: "0x994bd74b"
	volume: 1.600
	pitch: 2.200
	damage_type: shrapnel
	damage_type_secondary: explosion
    flags: any_damage, explode_when_primed, primed_when_destroyed
}

