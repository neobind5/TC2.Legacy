{
	sprite:
	{
		texture: "bomb.small"
	}
	offset: [0.000, -0.250]
}

transform:
{

}

explosive:
{
	radius: 4.000
	power: 6.000
	damage_entity: 8000.000
	damage_terrain: 7000.000
