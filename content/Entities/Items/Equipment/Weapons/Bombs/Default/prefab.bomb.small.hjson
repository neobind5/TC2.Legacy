$name: "Bomb (Small, Impact)"
$desc:
	'''
	Cheap impact explosive.
	'''
$tags: []

control:
{

}

body:
{
	@shape.circle:
	{
		mass: 40.500
		radius: 0.500
		friction: 0.500
		elasticity: 0.100
		material: metal
		layer: entity, solid, flammable
		mask: world
	}
	fall_damage_multiplier: 25.000
	gravity: 1.55
}

health:
{
	max: 1500.000
}

