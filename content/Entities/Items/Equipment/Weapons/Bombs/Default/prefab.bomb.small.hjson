	smoke_amount: 1.200
	sparks_amount: 2.500
	smoke_lifetime_multiplier: 0.500
	smoke_velocity_multiplier: 1.200
	flash_duration_multiplier: 0.550
	flash_intensity_multiplier: 0.200
	volume: 1.000
	pitch: 2.300
	damage_type: shrapnel
	damage_type_secondary: explosion
    flags: any_damage, explode_when_primed, primed_when_destroyed
}

