$name: "Timbr Grindr"
$desc:
	'''
	An ancient tool of murderhobos and bandits alike, its secrets uncovered by only the most fanatical of Kobold scrapmasters.
	'''
$tags: []

body:
{	
	buoyancy: 0.050

	@shape.line:
	{
		a: [-1.125, 0.125]
		b: [1.000, -0.100]
		mass: 6.500
		radius: 0.320
		friction: 0.600
		elasticity: 0.450
		material: metal
		layer: entity, solid, item, flammable
		mask: world
	}
}

gun:
{
	muzzle_offset: [1.250, -0.0625]
	receiver_offset: [-0.500, -0.125]
	
	eject_direction: [-4.800, -5.400]
	eject_angular_velocity: 10.000
	
	shake_amount: 0.390
	
	sound_size: 3.000
	sound_dist_multiplier: 2.500
	
	sound_shoot: BanditRifleFire
	sound_cycle: revolver_cycle
	sound_reload: gun.shell.eject.00
	
	damage_multiplier: 2.400
	velocity_multiplier: 340.000
	velocity_max: 520.000
	jitter_multiplier: 0.290
	recoil_multiplier: 1.850
	muzzle_blast_mult: 1.100
	reload_interval: 2.400
	cycle_interval: 0.400
	stability: 2600.000
	failure_rate: 0.100
	
	ammo_filter: ammo_sg, granular
	max_ammo: 5.000
	
	action: bolt
	type: rifle
	feed: clip
	
	heuristic_range: 50.000

	@inventory1:
	{
		stack_size_multiplier: 1.000
		type: ammo
		flags: hidden, ignore_mass, no_auto_pickup

		filter:
		{
			require: ammo
			exclude: gas
		}
	}
	
	@light:
	{
		color: [1.000, 0.400, 0.100, 2.000]
		offset: [1.250, -0.125]
		scale: [24.000, 16.000]
		intensity: 0.000
		texture: "light.circle.00"
	}
}

gun.state:
{

}

holdable:
{
	offset: [-0.625, 0.125]
	radius: 4.000
	flags: storable

	force_multiplier: 2.800
	torque_multiplier: 1.950
}

animated.renderer:
{
	sprite:
	{
		texture: "timbrgrindr"
	}
}

health:
{
	max: 3200.000
}

transform:
{

}

control:
{

}

aimable:
{
	min: -0.750
	max: 0.600
}

packable:
{

}