$name: "Mini Drill"
$desc: 
	'''
	Lightweight drill for quick excavation.
	'''
$tags: []

body:
{
	buoyancy: 0.050
	fall_damage_multiplier: 0.500

	@shape.line:
	{
		material: machine
		miss_chance: 0.000
		flags: none
		tags: none
		
		layer: entity, solid, item, shield, conductive, magnetic
		mask: world
		exclude: resource
		
		mass: 10.000
		radius: 0.300
		friction: 0.650
		elasticity: 0.250
		
		cog_offset: [0.125, 0.000]
		
		a: [-0.500, 0.125]
		b: [0.175, 0.000]
		offset: [0.000, 0.000]
	}
}

health:
{
	max: 8000.000
}

drill:
{
	damage: 95.000
	damage_terrain_multiplier: 20.000

	max_distance: 1.800
	speed: 3.600
	radius: 1.200
	
	//@inventory4:
	//{
	//	name: "Mini Drill"
	//	stack_size_multiplier: 2.000
	//	type: storage
	//	flags: hidden, allow_ducts
	//}
}

// interactable:
// {
// 	window_size: [192.000, 48.000]
// }

holdable:
{
	offset: [-0.300, -0.125]
	force_multiplier: 0.750
	torque_multiplier: 5.850
	stress_multiplier: 0.500
	hints: armor, tools, weapon, dangerous, heavy, melee, short_range, machine, defensive, usable, destructive, mining, gathering, industrial, slow, clumsy
	flags: storable
}

attachment:
{
	offset: [-0.500, 0.125]
	flags: none
	tags: small, weapon, tool, utility, rotary, linear, fixed, coaxial
}

animated.renderer:
{
	sprite:
	{
		texture: "drill"
	}
	offset: [0.400, -0.100]
}

sound.emitter:
{
	file: "drill"
	flags: start_muted
	volume: 1.000
	pitch: 1.000
}

heat:
{
	heat_medium: 450.000
	heat_high: 600.000
	heat_critical: 700.000
	cool_rate: 75.000
	
	@light:
	{
		color: [1.000, 0.400, 0.100, 2.000]
		offset: [0.750, 0.000]
		scale: [16.000, 16.000]
		intensity: 0.000
		texture: "light.circle.00"
	}
	
	@sound.emitter:
	{
		file: "overheat_loop"
		flags: start_muted
		volume: 1.000
		pitch: 1.000
	}
}

transform:
{

}

packable:
{

}

control:
{

}

aimable:
{

}