$name: "Hammer"
$desc:
	'''
	Yes, it's a ball peen hammer. Grow up.
	'''
$tags: []

body:
{
	buoyancy: 0.050

	@shape.polygon:
	{
		material: metal_solid
		miss_chance: 0.000
		flags: none
		tags: none
		
		layer: entity, solid, ignore_bullet, item, flammable, conductive, magnetic
		mask: world
		exclude: none
		
		mass: 6.000
		radius: 0.150
		friction: 0.450
		elasticity: 0.650
		
		cog_offset: [0.000, 0.000]
		
		points:
		[
			[-0.500, -0.875]
			[0.500, -0.875]
			[0.100, 0.800]
			[-0.100, 0.800]
		]
	}
}

aimable:
{
	deadzone: 0.250
	offset: [0.000, 0.000]
}

health:
{
	max: 4000.000
}

melee:
{
	damage_base: 500.000
	damage_bonus: 150.000
	
	terrain_damage_multiplier: 4.000
	pain_multiplier: 0.800
	stun_multiplier: 1.100
	
	disarm_chance: 0.370
	cooldown: 1.300
	max_distance: 1.100
	aoe: 0.600
	thickness: 0.500
	knockback: 300.000
	yield: 0.900
	penetration_falloff: 0.680
	penetration: 0
	
	hit_offset: [0.200, 0.000]
	
	swing_offset: [0.500, 0.875]
	swing_rotation: -2.000
	
	sound_volume: 1.000
	sound_size: 1.000
	sound_pitch: 0.640
	
	damage_type: sledgehammer
	category: blunt
	flags: friendly_fire
	
	damage_flags_add: no_loot_discard, force_loot_notification
	damage_flags_rem: no_loot_notification
	
	hit_mask: world, destructible
	hit_exclude: background, water, fire, gas, powder, liquid, stored
	hit_ignore: water, fire, gas, powder, liquid, stored
}

melee.state:
{

}

holdable:
{
	offset: [0.000, 0.400]
	force_multiplier: 0.600
	torque_multiplier: 0.700
	stress_multiplier: 0.450
	hints: tools, weapon, melee, short_range, powerful, usable, destructive, slow, clumsy, long, gathering, mining
	flags: storable
}

animated.renderer:
{
	sprite:
	{
		texture: hammer.00
	}
}

