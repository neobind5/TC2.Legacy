$name: "Ominious Cloak"
$desc:
	'''
	Gives you the feeling of overwhelming dread.

	And an interest in squids. Strange.
	'''
$tags: []
$prefab: "hat.00"

body:
{
	@shape.circle:
	{
		mass: 1.000
		radius: 0.400
		friction: 0.500
		elasticity: 0.050
