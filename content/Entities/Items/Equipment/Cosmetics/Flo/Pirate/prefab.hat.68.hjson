$name: "Pirate Captain's Hat"
$desc:
	'''
	The uptick in unregistered zeppelins and aircraft in Kordel has been problematic.

	Smaller supply craft are sometimes raided, but it usually gets covered up somehow.

	Some would say they're just larping as pirates.
	'''
$tags: []
$prefab: "hat.00"

body:
{
	@shape.circle:
	{
		mass: 1.000
		radius: 0.400
		friction: 0.500
		elasticity: 0.050
		material: fabric
	}
}

animated.renderer:
{
	sprite:
	{
		texture: "hat.68"
		// mask: "hat.10.mask"
		size: [16, 16]
		frame: [0, 0]
	}
}