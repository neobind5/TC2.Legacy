$name: "Padded Chapka"
$desc:
	'''
	A padded chapka to keep your ears from falling off.

	Unfortunately doesn't block any sound.
	'''
$tags: []
$prefab: "hat.00"

body:
{
	@shape.circle:
	{
		mass: 1.000
		radius: 0.400
		friction: 0.500
		elasticity: 0.050
		material: fabric
	}
}

animated.renderer:
{
	sprite:
	{
		texture: "hat.86"
		// mask: "hat.10.mask"
		size: [16, 16]
		frame: [0, 0]
	}
}