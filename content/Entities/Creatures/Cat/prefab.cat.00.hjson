	walk_lerp: 0.250
	jump_decay: 0.600
	crouch_speed_modifier: 0.500
	air_brake_modifier: 0.000
}

runner.state:
{
	
}

climber:
{
	max_speed: [8.000, 8.000]
	climb_speed: 20.000
	climb_force: 6200.000
	cling_force: 4000.000

	@shape.circle:
	{
		mass: 0.001
		radius: 0.375
		friction: 0.000
		elasticity: 0.000
		rigidity_dynamic: 0.000
		rigidity_static: 0.000
		layer: entity, ignore_hover, ignore_melee, ignore_bullet
		mask: climbable
		// flags: no_mass
	}
}

interactable:
{
	flags: no_tab
	window_size: [192.000, 232.000]
}

legs:
{
	sound_interval_multiplier: 1.100
	frame_count: 5
}

headbob:
{
	multiplier: [0.020, -0.080]
	speed: 15.000
}

+slot.head|instance:
{
	$tags: []
	
	joint.base:
	{
		//offset_a: [0.250, -0.625]
		offset_a: [0.250, -0.225]
		max_force: 22000.000
		max_torque: 2000.000
		torque_modifier: 1.096845
		max_stress: 3.000
		stress_threshold: 1.500
		z: 15.000
		material_type: flesh
		flags: organic, no_wrap, control_write, facing_reset_pos, force_facing, no_sync

		@animated.renderer:
		{
			sprite:
			{
				texture: "badger.gore.stub"
				size: [16, 16]
				frame: [3, 0]
			}
			offset: [0.000, 0.000]
			z: -25.000
		}
	}
	
	joint.pivot:
	{
		stress_mult: 0.800
		max_bias: 10.000
	}
	
	joint.rotaryspring:
	{
		stiffness: 800.000
		damping: 80.000
	}
	
	joint.rotarylimit:
	{
		max_torque: 11000.000
		min: -0.800
		max: 1.200
		max_bias: 8.000
		stress_mult: 0.800
	}
	
	+head|child:
	{
		$tags: []
		
		body:
