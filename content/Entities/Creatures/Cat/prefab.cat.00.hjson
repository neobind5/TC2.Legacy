$tags: []

$name: "Cat"
$desc: 
	'''
	Cute-looking cat that's not very into trees.
	'''
$export: false
$tags: ["cat"]

body:
{
	@shape.circle:
	{
		mass: 30.000
		offset: [0.000, 0.000]
		radius: 0.300
		friction: 0.700
		elasticity: 0.250
		material: flesh
		layer: entity, solid, creature, flammable
		mask: world
	}
}

organic:
{
	h_species: "cat"
	tags: heart, torso, legs, lungs
	pain_base: 2000.000
}

