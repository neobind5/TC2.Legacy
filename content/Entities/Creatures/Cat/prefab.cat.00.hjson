			fall_damage_multiplier: 0.500

			@shape.circle:
			{
				offset: [0.000, -0.125]
				mass: 20.000
				radius: 0.650
				friction: 0.400
				elasticity: 0.650
				material: flesh
				layer: entity, solid, creature, organic, flammable
				mask: world, vehicle
				exclude: barbed, dead, held

				miss_chance: 0.220
			}
		}
		
		lookat:
		{
			head_modifier: 0.900
			body_modifier: 0.000
			deadzone: [1.000, 8.000]
		}

		melee:
		{
			sound_volume: 0.800
			sound_size: 1.000
			sound_pitch: 0.600
			hit_offset: [0.875, 0.375]
			swing_offset: [0.625, -0.875]
			swing_rotation: -1.600
			damage_base: 14.000
			damage_bonus: 15.000
			primary_damage_multiplier: 0.800
			secondary_damage_multiplier: 1.000
			terrain_damage_multiplier: 0.500
			pain_multiplier: 0.400
			stun_multiplier: 0.450
			disarm_chance: 0.98
			cooldown: 0.260
			max_distance: 1.400
			aoe: 0.850
			thickness: 1.200
			knockback: -1150.000
			knockback_speed: 4.000
			yield: 0.800
			penetration_falloff: 0.800
			penetration: 3
			damage_type: slash
			category: misc
			flags: no_handle, no_material_filter
			damage_flags_add: no_loot_pickup, no_loot_drop, no_loot_notification
			hit_mask: item, creature, vehicle, door, organic, wheel, shield, held, attached
			hit_require: destructible
			hit_exclude: world, background, tree, essence, water, gas, ignore_melee
		}

		melee.state:
		{

		}
		
		organic:
		{
			h_species: "cat"
			tags: brain, head, eyes, mouth
			pain_base: 2000.000

			@animated.renderer:
			{
				sprite:
				{
					texture: "badger.gore.stub"
					size: [16, 16]
					frame: [2, 0]
				}
				offset: [0.000, 0.000]
				z: -39.000
			}
		}
		
		organic.state:
		{
		
		}
		
		health:
		{
			max: 3900.000
		}

		regen:
		{
			amount: 135.000
			interval: 10.000
		}

		//armor:
		//{
		//	toughness: 125.000
		//	protection: 0.983
		//	coverage: 0.780
		//	knockback_modifier: 1.350
