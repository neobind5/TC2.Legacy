		//	flags: no_damage_type_conversion, no_sound, no_particles
		//}
		
		holdable:
		{
			offset: [-0.125, 0.125]
		}
		
		animated.renderer:
		{
			sprite:
			{
				texture: "cat.00.head"
				count: 1
				size: [8, 8]
			}
			z: -30.000
			flags: has_damage
		}

		damage.effects:
		{
			offset: 1
			frame_count: 4
			threshold_wreck: 0.200
		}
				
		transform:
		{
		
		}
		
		head:
		{
			sound_pain: "cat.hit.00"
			sound_death: "cat.death.00"
