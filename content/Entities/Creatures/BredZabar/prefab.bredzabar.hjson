$name: "Bred Zabar"
$desc: "Predatory lizard that mostly lives within swamps. Its slimy, smooth carapace allows it to pass through obstacles with ease."
$export: false
$tags: 
[
	"zabar"
]

body:
{
	@shape.circle:
	{
		mass: 125.000
		radius: 0.625
		friction: 0.200
		elasticity: 0.050
		material: flesh
		layer: entity, solid, creature, flammable
		mask: world, vehicle
		exclude: barbed
	}
}

organic:
{
	h_species: "zabar"
	tags: heart, torso, legs, lungs
	pain_base: 2000.000
}

organic.state:
{

}

health:
{
	max: 11000.000
}

animated.renderer:
{
	sprite:
	{
		texture: "zabar.body.a"
		size: [16, 16]
	}
	z: -30.000
	flags: has_damage
}

damage.effects:
{

}

transform:
{

}

control:
{
	@net.synchronized:
	{
		interval: 0.000
	}
}

facing:
{

}

holdable:
{
	flags: disable_parent_facing, disable_rotation, disable_control, full_rotate
}

