$name: "Bred Pig"
$desc: 
	'''
	Cute, pink creature that toils in mud and eats their own faeces. Some would call them unclean.
	'''
$export: false
$tags: []

body:
{
	@shape.circle:
	{
		mass: 60.000
		offset: [0.000, -0.125]
		radius: 0.625
		friction: 0.700
		elasticity: 0.250
		material: flesh
		layer: entity, solid, creature, flammable
		mask: world
	}
}

organic:
{
	h_species: "pig"
	tags: heart, torso, legs, lungs
	pain_base: 2000.000
}

