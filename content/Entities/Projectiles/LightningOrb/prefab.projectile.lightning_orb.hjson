$tags: []

body:
{
	type: dynamic
	
	@shape.line:
	{
		material: metal_solid
		miss_chance: 0.447
		flags: none
		tags: none
		
		layer: entity, solid, item
		mask: world, essence
		exclude: none
		
		mass: 400.000
		radius: 0.625
		friction: 0.600
		elasticity: 0.400
		
		cog_offset: [0.500, 0.000]
		
		a: [-1.750, 0.000]
		b: [1.500, 0.000]
		offset: [0.000, 0.000]
	}
	gravity: 0.01
}

animated.renderer:
{
	sprite:
	{
		texture: "lightning_orb"
		size: [16,16]
		count: 4
		fps: 20
	}
	z: -200.000
}

//projectile.renderer:
//{	
//	intensity: 3.000
//	thickness_a: 0.100
//	thickness_b: 0.050
//}

zapper:
{
	damage: 500.000
	offset_a: [0.000, 0.000]
	offset_b: [0.000, 0.000]

	@shape.circle:
	{
		offset: [0.000, -1.500]
		mass: 1.000
		radius: 6.000
		friction: 0.000
		elasticity: 0.000
		rigidity_dynamic: 0.000
		rigidity_static: 0.000
		material: none
		layer: none
		mask: creature, organic
		exclude: resource
	}

	@light:
	{
		color: [0.650, 0.800, 1.000, 1.800]
		offset: [0.000, 0.000]
		scale: [16.000, 16.000]
		intensity: 1.000
		texture: "light.circle.00"
	}

	@sound.emitter:
	{
		file: "zapper.loop.00"
		volume: 1.000
		size: 1.000
		size_max_modifier: 1.000
		pitch: 1.000
	}
}

zapper.state:
{
	flags: powered
}

transform:
{

}