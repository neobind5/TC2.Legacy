body:
{
	type: static
	
	@shape.box:
	{
		size: [3.750, 1.000]
		offset: [0.000, 0.875]
		mass: 750.000
		friction: 0.700
		elasticity: 0.500
		material: metal
		layer: entity, solid, building, storage
		mask: world, resource, solid, vehicle, wheel
	}
}

health:
{
	max: 1800.000
}

animated.renderer:
{
	sprite:
	{
		texture: "grinder"
	}
	z: 280.000
}
animated.renderer|"idx_00":
{
	sprite:
	{
		texture: "grinder_bg"
	}
	z: -480.000
}

renderrotatea:
{
	speed: -16.200
	@animated.renderer:
	{
		sprite:
		{
			texture: grinder.wheel
		}
		offset: [-0.900, -0.200]
		z: -300.000
	}
}
renderrotateb:
{
	speed: 16.200
	@animated.renderer:
	{
		sprite:
		{
			texture: grinder.wheel
		}
		offset: [0.900, -0.200]
		z: -300.000
	}
}

