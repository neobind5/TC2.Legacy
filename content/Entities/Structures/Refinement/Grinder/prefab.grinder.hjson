				}
			]
			products:
			[
				{
					material: cement
					count: 7
				}
				{
					material: wood
					count: 5
				}
			]
		}
		{
			// Crude Scrap Grinding
			requirements:
			[
				{
					material: scrap.mixed
					count: 5.000
				}
			]
			products:
			[
				{
					material: niklajzner
					count: 3
				}
				{
					material: copper
					count: 2.1
				}
			]
		}
		{
			// Crude Grain Milling
			requirements:
			[
				{
					material: grain
					count: 5.000
				}
