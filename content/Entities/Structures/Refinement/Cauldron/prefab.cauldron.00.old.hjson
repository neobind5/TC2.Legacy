$name: "Cauldron"
$desc:
	'''
	Spigoted cauldron for all your brewing needs.
	'''
$tags: []

body:
{
	type: static

	@shape.line:
	{
		material: metal_solid
		miss_chance: 0.737
		flags: none
		tags: none
		
		layer: entity, solid, background, building, workshop, crafter, furniture, conductive, heatable, magnetic, ignore_melee
		mask: world, building
		exclude: none
		
		mass: 95.000
		radius: 0.750
		friction: 0.850
		elasticity: 0.400
		
		cog_offset: [0.000, 0.000]
		
		a: [0.000, -0.500]
		b: [0.000, 0.500]
		offset: [0.000, 0.000]
	}
}

health:
{
	max: 37500.000
}

animated.renderer:
{
	sprite:
	{
		texture: "cauldron.00"
		size: [16, 24]
		frame: [0, 0]
	}
	z: -66.400
}

transform:
{

}

faction:
{

}

claimable:
{
	flags: no_menu, enable_wololo
}

interactable:
{
	flags: no_tab
	priority: 1.800
	window_size: [616.000, 616.000]
	window_size_min: [192.000, 96.000]
	window_size_misc: [144.000, 0.000]
	window_offset: [-192.000, 0.000]
}

shop:
{
	tags_filter:
	{
		include: raw
		require: crude
		exclude: advanced, large, huge
	}
	
	tools: hammer, cutters, saw, hand_drill, bucket, axe, shovel, tongs, pick
	infrastructure: oven, rack, shaping_mould, surface, hard_surface, heater, burner, stove, kiln, smokestack, form, structure
	environment: container, stationary, dirty, scary, fireproof, durable, sturdy, enclosed, cramped, waterproof, small
	connotations: none
	
	flags: embed_gui
	menu_columns: 3
	recipe_type: workshop
	
	offset_spawn: [-0.375, -0.125]
	
	name: "Simple Furnace"
}

crafter:
{
	flags: no_gui
	
	temperature_max: 949.000
	pressure_max: 3.000
	
	offset: [-0.375, -0.125]

	@inventory4:
	{		
		type: workshop
		flags: standalone, allow_ducts, ignore_mass, no_auto_pickup, vertical
		stack_size_multiplier: 1.000
		
		filter:
		{
			include: soft, malleable, granular, viscous, small, gravel, powder, bottled
			exclude: gas
		}
		offset: [-0.500, -0.125]
	}
}

workshop:
{
	orders_capacity: 1
	
	gui_info_size_x: 252.000
	max_order_mass: 250000.000
	
	h_sound_order_complete: computer.bell.00
}

shipment:
{
	flags: keep_items, allow_deposit, use_misc, no_empty_deposit, crafting, no_body_mass
	type: crafting
	layout: square
	color: "0xfff0c63e"
}