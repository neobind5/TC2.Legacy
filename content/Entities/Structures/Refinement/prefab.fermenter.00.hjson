body:
{
	type: static

	@shape.polygon:
	{
		material: wood
		miss_chance: 0.745
		flags: none
		tags: none
		
		layer: entity, solid, building, support, ignore_melee, background, crafter, flammable
		mask: world, building
		exclude: none
		
		mass: 84.000
		radius: 0.480
		friction: 0.750
		elasticity: 0.410
		
