		[
			[-0.750, -0.375]
			[0.750, -0.375]
			[0.625, 1.000]
			[-0.625, 1.000]
		]
	}
}

health:
{
	max: 4500.000
}

animated.renderer:
{
	sprite:
	{
		texture: "fermenter.00"
		size: [24, 24]
		frame: [0, 0]
	}
	z: -150.000
}

transform:
{

}

interactable:
{
	flags: no_tab
	window_size: [192, 192]
	window_size_misc: [96, 0]
	priority: 2.000
}

storage:
{
	@inventory16:
	{	
		type: storage
		flags: allow_ducts, ignore_mass, public, faction
		stack_size_multiplier: 4.000
		
		filter:
		{
			exclude: gas
		}
		offset: [-0.625, -0.250]
	}
}

