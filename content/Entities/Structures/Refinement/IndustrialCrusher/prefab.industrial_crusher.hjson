$name: "Industrial Crusher"
$desc:
	'''
	Pulverizes materials into their most basic components quickly.
	Collects certain materials regular grinders fail to.
	'''
$tags: []

body:
{
	type: static
	
	@shape.box:
	{
		size: [2.000, 3.000]
		offset: [0.000, 0.000]
		friction: 0.500
		elasticity: 0.500
		material: metal
		layer: entity, solid, building, support, ignore_melee, background, crafter
		mask: world, building
		exclude: none
	}
}

health:
{
	max: 25000.000
}

animated.renderer:
{
	sprite:
	{
		texture: "industrial_crusher"
	}
	z: -280.000
}

transform:
{

}

health:
{
	max: 40000.000
}

interactable:
{
	flags: no_tab
	window_size: [192, 192]
	window_size_misc: [96, 0]
	priority: 2.000
}

faction.colorable:
{
	intensity_a: 0.600
}

faction:
{

}

claimable:
{
	flags: allow_owner_unclaim
}

transform:
{

}

building:
{

}

nameable:
{
	tags: lame, homely, industrial, tool, factory
	type: location
	flags: randomize
	max_length: 16
}

storage:
{
	@inventory16:
	{	
		type: storage
		flags: allow_ducts, ignore_mass, public, faction
		stack_size_multiplier: 4.000
		
		filter:
		{
			exclude: gas
		}
		offset: [-0.625, -0.250]
	}
}

autocrafter:
{
	flags: force_drop
	sound_load: produce_sound
	cooldown: 1.000
	drop_offset: [1, -0.8750]
	recipes:
	[
		{
			// Crude Stone Grinding
			requirements:
			[
				{
					material: stone
					count: 50.000
				}
			]
			products:
			[
				{
					material: gravel
