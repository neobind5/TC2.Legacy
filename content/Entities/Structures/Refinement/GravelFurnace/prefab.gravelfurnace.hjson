$name: "Simple Furnace"
$desc:
	'''
	Piece of shit furnace you cobbled together with cobble.
	Capable of woodburning, brick and ingot creation, nikl carbonization, and soda-lime glass production from silicon.

	Automatically produces products out of materials put inside.
	'''
$tags: []

body:
{
	type: static
	
	@shape.polygon:
	{
		points:
		[
			[-0.650, 0.625]
			[0.800, 0.625]
			[1.000, 2.625]
			[-0.875, 2.625]
		]
		
		mass: 220.000
		radius: 0.375
		friction: 0.650
		elasticity: 0.200
		
		material: stone_slab
		miss_chance: 0.702
		
		layer: entity, solid, building, support, ignore_melee, background, crafter
		mask: world, building
		exclude: none
	}
}

animated.renderer:
{
	sprite:
	{
		texture: "gravelfurnace"
		size: [32, 48]
	}
	z: -280.000
}

control:
{

}

health:
{
	max: 1800.000
}

transform:
{

}

faction:
{

}

claimable:
{
	flags: allow_owner_unclaim
}

interactable:
{
	flags: no_tab
	window_size: [192, 192]
	window_size_misc: [96, 0]
	priority: 2.000
}

storage:
{
	@inventory16:
	{	
		type: storage
		flags: allow_ducts, ignore_mass, public, faction, no_auto_pickup
		stack_size_multiplier: 4.000
		
		filter:
		{
			exclude: gas
		}
		offset: [-0.625, -0.250]
	}
}

inserterfilter:
{
	flags: disable_edits
	search_radius: 0.75
}

itemfilter:
{
	materials:
	[
		wood
		copper
		niklajzner
		silver
		gold
		smirglum
	]
}

autocrafter:
{
	flags: force_drop
	sound_load: produce_sound
	cooldown: 4.000
	drop_offset: [0, 0]
	recipes:
	[
		{
			// Crude Wood Burning
			requirements:
			[
				{
					material: wood
					count: 10.000
				}
			]
			products:
			[
				{
					material: karban
					count: 10.00
				}
				//{
				//	material: black_coal
				//	count: 10.00
				//}
				{
					material: ash
					count: 4
				}
			]
		}
		{
			// Crude Glass Smelting
			requirements:
			[
				{
					material: silicon
					count: 10.000
				}
				{
					material: ash
					count: 3.000
				}
				{
					material: lime
					count: 5.000
				}
			]
			products:
			[
				{
					material: glass
					count: 4.00
				}
			]
		}
		{
			// Crude Clay Bricks
			requirements:
			[
				{
					material: clay
					count: 15.000
				}
			]
			products:
			[
				{
					material: brick.clay
					count: 5.00
				}
			]
		}
		//{
		//	// Crude Concrete
		//	requirements:
		//	[
		//		{
		//			material: cement
		//			count: 15.000
		//		}
		//	]
		//	products:
		//	[
		//		{
		//			material: brick.concrete
		//			count: 5.00
		//		}
		//	]
		//}
		{
			// Crude Copper Smelting
			requirements:
			[
				{
					material: copper
					count: 6.000
				}
			]
			products:
			[
				{
					material: copper.ingot
					count: 1
				}
			]
		}
		{
			// Crude Niklajzner Smelting
			requirements:
			[
				{
					material: niklajzner
					count: 8.000
				}
			]
			products:
			[
				{
					material: niklajzner.ingot
					count: 1
				}
			]
		}
		{
			// Crude Niklajzner Smelting
			requirements:
			[
				{
					material: smirglum
					count: 8.000
				}
			]
			products:
			[
				{
					material: smirglum.ingot
					count: 1
				}
			]
		}
		{
			// Crude Smirglum Smelting
			requirements:
			[
				{
					material: niklajzner.ingot
					count: 3.000
				}
				{
					material: karban
					count: 6.000
				}
			]
			products:
			[
				{
					material: steel.ingot
					count: 2
				}
			]
		}
		{
			// Crude Silver Smelting
			requirements:
			[
				{
					material: silver
					count: 6.000
				}
			]
			products:
			[
				{
					material: silver.ingot
					count: 1
				}
			]
		}
		{
			// Crude Gold Smelting
			requirements:
			[
				{
					material: gold
					count: 8.000
				}
			]
			products:
			[
				{
					material: gold.ingot
					count: 1
				}
			]
		}
	]
}