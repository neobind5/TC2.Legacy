$tags: []

body:
{
	type: static
	
	@shape.polygon:
	{
		material: building_reinforced
		miss_chance: 0.000
		flags: none
		tags: none
		
		layer: entity, building, support, workshop, ignore_melee, ignore_bullet
		mask: world, building
		exclude: none
		
		mass: 5000.000
		radius: 0.750
		friction: 0.500
		elasticity: 0.500
		
		cog_offset: [0.000, 0.000]
		
		points:
		[
			[-2.000, 0.250]
			[2.000, 0.250]
			[3.000, 4.000]
			[-3.000, 4.000]
		]
	}

	// @shape.line:
