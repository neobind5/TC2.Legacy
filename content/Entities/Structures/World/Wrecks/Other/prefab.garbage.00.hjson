$name: "Boxed Garbage"
$desc:
	'''
	Awful treasure that nobody wants.
	'''
$tags: []

body:
{
	type: static
	
	@shape.polygon:
	{
		points:
		[
			[-1.125, 0.000]
			[-0.625, -0.375]
			[0.875, 0.500]
			[-1.125, 0.500]
		]
		
		mass: 500.000
		radius: 0.600
		friction: 0.850
		elasticity: 0.100
		
		material: wood
		
		layer: entity, solid, harvestable, flammable, ignore_melee
		miss_chance: 0.760
	}
}

health:
{
	max: 8500.000
}

animated.renderer:
{
	sprite:
	{
		texture: "atlas.garbage.00"
		size: [32, 16]
		frame: [0, 0]
	}
	z: -100.000
}

transform:
{

}

interactable:
{
	flags: no_tab, centered_inventory
	window_size: [192.000, 192.000]
	window_size_misc: [48.000, 0.000]
	window_offset: [32.000, 96.000]
}

harvestable:
{
	resources:
	[
		{
			material: "scrap.mixed"
			quantity: 180.000
		}
		{
			material: "wood"
			quantity: 90.000
		}
	]
}

shipment:
{
	type: trash
	flags: keep_items, allow_withdraw, allow_deposit, use_misc
}

loot.container:
{
	rolls: 2
	rolls_extra: 3

	rarity_min: 0.000
	rarity_mid: 2.500
	rarity_max: 3.000

	merge_flags: skip_resources, bias_weight, bias_amount
	flags: none

	tables:
	[
	]
}

storage:
{
	@loot.container:
	{
		rolls: 6
		rolls_extra: 11
		rarity_min: 0.000
		rarity_mid: 1.000
		rarity_max: 8.000
		amount_multiplier: 1.000
		merge_flags: skip_prefabs, bias_weight, bias_amount
		flags: shuffle_inventory

		tables:
		[
			junk.00
			bleh.00
		]
	}

	@inventory16:
	{
		type: storage
		flags: public, no_auto_pickup
		stack_size_multiplier: 2.000
		
		offset: [0.000, 0.000]
	}
}