$name: "Tavern"
$desc: "Grubby tavern for the unemployed."

body:
{
	type: static
	
	@shape.box:
	{
		size: [3.250, 2.500]
		offset: [0.000, -0.250]
		
		mass: 360.000
		radius: 0.500
		
		material: building_wood
		
		layer: entity, building, support, ignore_melee, ignore_bullet, flammable
		mask: world, building
	}
}

animated.renderer:
{
	sprite:
	{
		texture: "tavern"
		mask: "tavern.mask"
	}
	z: -300.000
}

interactable:
{
	flags: no_tab
	window_size: [720, 576]
	window_size_misc: [192, 0]
	priority: 1.000
}

health:
{
	max: 10500.000
}

transform:
{

}

building:
{

}

nameable:
{
	tags: lame, homely, food
	flags: randomize
	type: building
	max_length: 16
}

address:
{
	
}

entrance.linkable:
{

}

minimap.marker:
{
	sprite:
	{
		texture: "ui_icons_minimap"
		size: [16, 16]
		frame: [1, 0]
	}
	flags: spawner
}

shipment:
{
	flags: keep_items, allow_withdraw, allow_deposit, no_gui, faction, no_body_mass
	type: armory
	layout: large
}

spawn:
{
	flags: none
}

dormitory:
{
	flags: no_kit_selection, no_kit_requirements, region_only
	species: human
	
	characters_capacity: 10
	characters_initial_count: 0
	characters_reserved_count: 0
	
	repopulate_max: 10
	repopulate_num: 1
	repopulate_num_extra: 0
	repopulate_interval: 30.000
	repopulate_interval_extra: 0.000
	repopulate_character_flags_add: none
	
	asset_flags: recycle
	character_flags_filter:
	{
		include: unskilled, laborer, brawler, outdoor, lower_middle_class
		exclude: sedentary, upper_middle_class, upper_class, elite_class
	}
	kit_categories_filter:
	{
		exclude: explosive, advanced, expensive
	}
}