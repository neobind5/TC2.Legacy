$name: "Hand Grinder"
$desc:
	'''
	Grind simple materials with your hands, or grind your hands with simple materials.
	'''
$tags: []

body:
{
	type: static
	
	@shape.box:
	{
		size: [2.000, 3.000]
		offset: [0.000, 0.000]
		friction: 0.500
		elasticity: 0.500
		material: metal
		layer: entity, building, storage, ignore_melee
		mask: world
	}
}

health:
{
	max: 8000.000
}

animated.renderer:
{
	sprite:
	{
		texture: "grinder.small"
	}
	z: -280.000
}

transform:
{

}

health:
{
	max: 40000.000
}

interactable:
{
	flags: no_tab
	window_size: [768, 592]
	window_size_misc: [96, 0]
	priority: 2.000
}

faction.colorable:
{
	intensity_a: 0.600
}

faction:
{

}

claimable:
{
	flags: allow_owner_unclaim
}

transform:
{

}

building:
{

}

nameable:
{
	tags: lame, homely, industrial, tool, factory
	type: location
	flags: randomize
	max_length: 16
}

shop:
{
	tags_filter:
	{
		include: crude, processing
		exclude: advanced, large, huge, moulding
	}
	
	flags: embed_gui
	menu_columns: 5
	recipe_type: workshop
	
	offset_spawn: [1.000, 0.250]
	
	name: "hand grinder"
}

workshop:
{
	orders_capacity: 1
	h_sound_order_complete: order_complete
	max_order_mass: 100000.000
	gui_info_size_x: 332.000

	@inventory8:
	{	
		type: workshop
		flags: standalone, allow_ducts, ignore_mass, public, faction, vertical
		stack_size_multiplier: 4.000
		
		filter:
		{
			exclude: gas
		}
		offset: [-0.625, -0.250]
	}
}

crafter:
{
	tools: pencil, paper, ruler, hammer, saw, screwdriver, wrench, pliers, bucket, file, tongs, knife
	machinery: heater, burner, stove
	infrastructure: oven, anvil, forge, barrel, table, chair, vise, rack, crucible
	environment: workshop, stationary, dirty, noisy
	temperature_max: 1593.150

	@inventory4:
	{	
		type: waste
		flags: standalone, allow_ducts, ignore_mass
		stack_size_multiplier: 2.000
		
		filter:
		{
			exclude: gas
		}
		offset: [1.125, 0.250]
	}
}