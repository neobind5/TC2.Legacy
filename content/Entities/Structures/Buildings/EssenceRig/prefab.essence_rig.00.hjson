essence_rig:
{
	produce_interval: 30.000
	amount: 0.129
	amount_extra: 0.231

	@inventory1:
	{
		type: output
		flags: standalone, allow_ducts, ignore_mass, no_auto_pickup, no_drop
		stack_size_multiplier: 1.000
		offset: [-1.750, 0.625]
	}
}
