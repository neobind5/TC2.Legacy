transform:
{

}

interactable:
{
	window_size: [24.000, 24.000]
	window_size_misc: [96.000, 96.000]
}

claimable:
{
	flags: allow_owner_unclaim, allow_enemy_unclaim
}

minimap.marker:
{
	sprite:
	{
		texture: "ui_icons_minimap"
		size: [16, 16]
		frame: [3, 0]
	}

	flags: faction, spawner
}

sound.emitter:
{
		file: "furnace_loop"
		volume: 1.000
		pitch: 0.500
		size: 0.700
		size_max_modifier: 0.600
}

vibrate:
{
	frequency: 5.000
	modifier: 1.000
	rotation_mult: 0.009
	position_mult: [0.010, 0.020]
}

lamp:
{
	@light:
	{
		color: [1.000, 0.850, 0.400, 2.000]
		offset: [-1.350, -1.800]
		scale: [64.000, 128.000]
		intensity: 1.000
		texture: "light_invsqr"
	}
}

