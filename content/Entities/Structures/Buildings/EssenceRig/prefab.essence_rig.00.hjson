$name: "Essence Engine"
$desc:
	'''
	An advanced machine that brings phlogiston up from ancient pipelines.

	Can be claimed for your own use.
	'''
$tags: []

body:
{
	type: static
	
	@shape.polygon:
	{
		points:
		[
			[-1.000, -5.375]
			[1.000, -5.375]
			[0.875, 5.250]
			[-0.875, 5.250]
		]
		
		mass: 25000.000
		radius: 1.000
		friction: 0.500
		elasticity: 0.500
		
		material: metal
		miss_chance: 0.000
		
		layer: entity, building, ignore_melee
		mask: world
		exclude: none
	}
}

health:
{
	max: 395000.000
}

armor:
{
	toughness: 900.000
	protection: 0.750
	
	knockback_modifier: 1.300
	pain_modifier: 0.000

	material_type: metal
	flags: no_damage_type_conversion
}

animated.renderer:
{
	sprite:
	{
		texture: "essence_rig.00"
	}
	z: -280.000
}

