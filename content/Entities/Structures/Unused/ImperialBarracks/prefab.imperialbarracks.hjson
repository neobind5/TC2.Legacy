armory:
{
	@inventory4:
	{
		type: ammo
		flags: ignore_mass, no_auto_pickup, faction
		stack_size_multiplier: 4.000
		
		filter:
		{
			require: ammo, solid
			include: granular, small
			exclude: gas
		}

		offset: [0.000, -1.250]
	}
}

shipment:
{
	flags: keep_items, allow_withdraw, allow_deposit, no_gui, faction, no_body_mass
	type: armory
	layout: large
}

dormitory:
{
	flags: no_hiring, no_kit_selection, no_kit_requirements, region_only, hide_xp, recruit_into_squad
	species: human
	
	characters_capacity: 8
	characters_initial_count: 4
	characters_reserved_count: 4
	
	repopulate_max: 8
	repopulate_num: 2
	repopulate_num_extra: 1
	repopulate_interval: 60.000
	repopulate_interval_extra: 0.000
	repopulate_character_flags_add: none
	
	kit_categories_filter:
	{
		require: none
		exclude: contraband, outlaw
	}

	asset_flags: recycle
	character_flags_filter:
	{
		include: military, armed, soldier
		weight: 5.000
	}
}

spawner:
{
	flags: none
	group_size: 3
	group_size_extra: 2
	max_count: 16
	ai_stance: aggressive
	ai_type: idle
	interval: 300.000
	interval_extra: 25.000
	interval_count_modifier: 1.000
}

shipment:
{
	flags: keep_items, no_gui, allow_deposit, allow_withdraw, faction
}