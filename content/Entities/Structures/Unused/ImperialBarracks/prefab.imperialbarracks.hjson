$name: "Bunker"
$desc: 
	'''
	Fortified building serving as a market, garrison and a factory.
	'''
$tags: []

body:
{
	type: static
	flags: none

	@shape.complex:
	{
		material: building_reinforced
		miss_chance: 0.200
		flags: none
		tags: heavy, large
		
		layer: entity, solid, building, support, conductive, magnetic
		mask: world
		exclude: crate
		
		mass: 15000.000
		radius: 0.750
		friction: 1.250
		elasticity: 0.100
		
		cog_offset: [0.000, 0.000]
		
		count: 7
		points:
		[
			[-2.125, -4.375]
			[0.000, -5.375]
			[2.250, -4.375]
			[2.500, 1.500]
			[1.250, 2.125]
			[-1.250, 2.125]
			[-2.500, 1.625]
			[0.000, 0.000]
		]
	}
}

health:
{
	max: 218500.000
}

armor:
{
	material_type: metal
	coverage: 0.451
	flags: no_damage_type_conversion
	toughness: 500.000
	protection: 0.940
}

animated.renderer:
{
	sprite:
	{
		texture: imperialbarracks.00
		mask: imperialbarracks.00.mask
		size: [64, 96]
		frame: [0, 0]
	}
	offset: [0.000, -2.000]
	z: -300.000
	flags: has_damage
}

damage.effects:
{
	threshold_wreck: 0.400
	
	offset: 0
	frame_count: 4
}

transform:
{

}

faction:
{
	id: "imperial.07"
}

nameable:
{
	tags: market
	flags: randomize, no_rename
	type: building
}

claimable:
{
	flags: no_menu
}

claimer:
{
	radius: 32.000
	strength: 10.000
	falloff: 1.000
}

spawn:
{
	flags: neutral_only, faction
}

company:
{
	h_company: postus
	logo_type: sign_2x2

	@animated.renderer:
	{
		offset: [0.750, -2.625]
		z: -295.000
	}

	// @light:
	// {
	// 	// color: [1.000, 0.750, 0.100, 2.000]
	// 	color: [1.000, 0.750, 0.100, 2.500]
	// 	offset: [0.000, -1.250]
	// 	scale: [12.000, 32.000]

	// 	intensity: 1.000
	// 	texture: "light.box.01"
	// }
}

lamp:
{
	flicker: 0.000
	blink_frequency: 1.000
	blink_amplitude: 0.500
	
	@light:
	{
		color: [1.000, 0.400, 0.000, 2.000]
		offset: [1.875, -5.750]
		scale: [56.000, 56.000]
		intensity: 1.000
		texture: "light.circle.00"
	}
}

sound.emitter:
{
	file: conveyor.loop.01
	volume: 0.500
	pitch: 0.570
	size: 3.000
	size_max_modifier: 0.650
	spread: 80.000
	priority: 0.300
}

