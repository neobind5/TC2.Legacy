// 	priority: 0.300
// }

interactable:
{
	flags: no_tab
	window_size: [730, 536]
	window_size_misc: [192, 0]
	priority: 2.000
}

minimap.marker:
{
	sprite:
	{
		texture: "ui_icons_minimap"
		size: [16, 16]
		frame: [7, 0]
	}

	flags: faction, spawner
}

building:
{

}

address:
{
	flags: auto_generate, no_editing, public
}

laboratory:
{
	filter_tags:
	{
		require: crafting
		include: device, weapon, gun, vehicle, munitions, medical, biology, military, tailoring
		exclude: huge, architecture
	}
	
	blueprints_capacity: 2
	augments_capacity: 12
	flags: none
}

shop:
{
	tags_filter:
	{
		include: military
	}
	
	tools: none
	infrastructure: none
	environment: none
	connotations: none
	
	flags: embed_gui
	menu_columns: 5
	recipe_type: workshop
	
	offset_spawn: [0.000, 0.375]
	
	name: "Bunker"
}

workshop:
{
	orders_capacity: 2

	@inventory8:
	{
		type: workshop
		flags: standalone, ignore_mass, public, no_auto_pickup, faction, horizontal
		stack_size_multiplier: 2.000
		
		filter:
		{
			exclude: gas
		}
		offset: [1.375, -0.125]
	}

	// @inventory8:
	// {
	// 	type: output
	// 	flags: standalone, ignore_mass, public, no_auto_pickup, faction
	// 	stack_size_multiplier: 4.000
		
	// 	filter:
	// 	{
	// 		exclude: gas
	// 	}
	// 	offset: [0.000, 0.500]
	// }
}

crafter:
{
	h_crafter: market.siege.00
	flags: hide_temperature, hide_pressure
	distance_max: 12.000
	temperature_max: 893.150
	pressure_max: 40.000
	
	tools: pencil, paper, ruler, hammer, saw, screwdriver, wrench, pliers, bucket, file, tongs, knife
	infrastructure: oven, anvil, forge, barrel, table, chair, vise, rack, crucible
	environment: workshop, stationary, dirty, noisy
	offset: [0.000, 0.000]
}

