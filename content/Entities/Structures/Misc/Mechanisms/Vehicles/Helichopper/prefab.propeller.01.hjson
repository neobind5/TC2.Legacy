control:
{

}

propeller:
{
	speed_step: 4.000
	speed_max: 4.000
	animation_modifier: 100.000
	max_tilt: 3.000
	force_modifier: -12000.000
	flags: none

	@sound.emitter:
	{
		file: "propeller.loop.00"
		flags: start_muted
		volume: 0.300
		pitch: 0.600
		size: 0.800
		size_max_modifier: 1.400
	}
}