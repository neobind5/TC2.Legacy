$name: "Propeller (Top)"
$desc:
	'''
	TODO: Desc
	'''
$tags: []

body:
{
	fall_damage_multiplier: 0.8

	@shape.line:
	{
		a: [-1.250, -0.125]
		b: [1.250, -0.125]
		mass: 30.000
		radius: 0.500
		friction: 1.850
		elasticity: 0.850
		material: wood
		layer: entity, solid
		mask: world
		exclude: tree, attached
	}
}

health:
{
	max: 8500.000
}

animated.renderer:
{
	sprite: 
	{
		texture: "propeller.01"
		fps: 60.000
		count: 18
		size: [32, 8]
	}
		
	z: 100.000
}

transform:
{

}

holdable:
{
	offset: [0.000, 0.000]
	radius: 0.000
	flags: disable_parent_facing, disable_control
	stress_multiplier: 0.500
}

attachment:
{
	offset: [0.000, 0.000]
	radius: 0.000
	flags: disable_parent_facing
}

