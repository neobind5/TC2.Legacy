interactable:
{
	flags: no_tab, centered_inventory
	priority: 0.750
	window_size: [192.000, 240.000]
	window_size_misc: [48.000, 0.000]
}

nameable:
{
	tags: lame, industrial, homely, food
	flags: randomize
	type: consumable
	max_length: 10
}