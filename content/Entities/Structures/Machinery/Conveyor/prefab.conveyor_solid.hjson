$tags: []
body:
{
	type: static

	@shape.line:
	{
		radius: 0.000
		a: [-3, 0.0]
		b: [3, 0.0]
		radius: 0.8
		mass: 1000.000
		friction: 0.05
		elasticity: 0.000
		material: metal
		layer: entity, support, solid, building, storage
		mask: world, resource, solid, vehicle, wheel
	}
}

health:
{
	max: 5200.000
}

animated.renderer:
{
	sprite:
	{
		texture: "conveyor_solid.anim"
		size: [256, 12]
		//fps:60
		count:4
	}
	z: -290.000
}

transform:
{

}

interactable:
{
	window_size: [192.000, 96.000]
}

faction:
{

}

//claimable:
