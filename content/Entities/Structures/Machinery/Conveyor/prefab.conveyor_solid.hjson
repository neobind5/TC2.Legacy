physconveyor:
{
	sound_load: ""
	strength: 0
	max_strength: 1.8
	dampening: 0.85
	volume: 0.6
	pitch: 0.9
	sound_cooldown: 1.0
	dist_multiplier: 0.4
	fps: 60
}

resizable:
{
	cap_a:
	{
		texture: "conveyor.end.a"
		size: [12, 12]
		//fps:60
		count:4
	}
	
	cap_b:
	{
		texture: "conveyor.end.b"
		size: [12, 12]
		//fps:60
		count:4
	}
	
	flags: shape_cap_offset
	
	a: [-2.250, 0.000]
	b: [2.250, 0.000]
	cap_offset: 0.500
}
