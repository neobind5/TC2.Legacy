$tags: []

body:
{
	type: static
	
	@shape.circle:
	{
		radius: 2.000
		offset: [0.000, 0.000]
		friction: 0.500
		elasticity: 0.500
		material: metal
		layer: entity, building
		mask: world
	}
}

health:
{
	max: 800000.000
}

animated.renderer:
{
	sprite:
	{
		texture: "shaft"
	}
	z: -150.000
}

axle:
{
	offset: [0.000, 0.000]
	mass: 2000.000
	friction: 0.01
	radius_a: 2.000
	radius_b: 0.750
	radius_inner: 1.750
	radius_outer: 2.000
	
	@animated.renderer:
	{
		sprite:
		{
			texture: "flywheel.smirglum.00"
		}
		z: -140.000
	}
}

transform:
{

}

interactable:
{
	flags: no_tab
	window_size: [192.000, 280.000]
}