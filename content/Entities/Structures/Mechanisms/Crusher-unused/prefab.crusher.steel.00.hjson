$name: "Flywheel (Steel)"
$desc:
	'''
	Heavy steel flywheel used for storing mechanical energy.
	'''
$tags: []

body:
{
	type: static
	
	@shape.circle:
	{
		radius: 2.000
		offset: [0.000, 0.000]
		friction: 0.500
		elasticity: 0.500
		material: metal
		layer: entity, building, no_overlapped_placement
		mask: world
	}
}

health:
{
	max: 800000.000
}

armor:
{
	toughness: 1000.000
	protection: 0.850
	
	knockback_modifier: 1.300
	pain_modifier: 0.000

	material_type: metal
	flags: no_damage_type_conversion
}

animated.renderer:
{
	sprite:
	{
		texture: "shaft"
	}
	z: -150.000
}

axle:
{
	offset: [0.000, 0.000]
	mass: 4000.000
	friction: 0.200
	radius_a: 2.000
	radius_b: 1.000
	radius_inner: 1.750
	radius_outer: 2.000
	z: -75.000
	
	@animated.renderer:
	{
		sprite:
		{
			texture: "flywheel.steel.00"
		}
		z: -140.000
	}

	@sound.emitter:
	{
		file: "flywheel.loop.01"
		volume: 1.000
		pitch: 1.000
		size: 4.000
		size_max_modifier: 0.800
	}
	
	@sound.mixer:
	{
		volume_modifier: 1.000
		pitch_modifier: 0.250
		volume_min: 0.000
		pitch_min: 0.500
		volume_lerp_a: 0.050
		volume_lerp_b: 0.050
		pitch_lerp_a: 0.050
		pitch_lerp_b: 0.050
	}
}

transform:
{

}

interactable:
{
	flags: centered_inventory
	window_size: [168.000, 168.000]
	window_size_misc: [88.000, 0.000]
}

module.slots:
{
	slot_type: motor
	offset: [0.000, 0.000]
	z: 100.000
}

