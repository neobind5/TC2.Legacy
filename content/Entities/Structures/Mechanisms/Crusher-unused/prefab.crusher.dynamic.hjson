$tags: []

body:
{
	type: dynamic
	
	@shape.circle:
	{
		offset: [0.000, 0.000]
		mass: 5000.000
		radius: 2.000
		friction: 0.700
		elasticity: 0.500
		material: metal_solid
		layer: entity, solid
		mask: world, solid
		exclude: tree, resource, essence
	}
}

health:
{
	max: 5000000.000
}

animated.renderer:
{
	sprite:
	{
		texture: "flywheel.steel.00"
	}
	z: -140.000
}

transform:
{

}