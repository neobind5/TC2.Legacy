$name: "Wooden Vehicle Chassis"
$desc:
	'''
	TODO: Desc
	'''
$tags: []

body:
{
	gravity: 1.000
	fall_damage_multiplier: 0.600

	@shape.polygon:
	{
		points:
		[
			[-2, -0.25]
			[2, -0.25]
			[2, 0.050]
			[-2, 0.050]
		]
		offset: [0.000, 0.000]
		mass: 100.000
		radius: 0.500
		friction: 0.800
		elasticity: 0.650
		rigidity_static: 1.000
		rigidity_dynamic: 1.000
		material: wood
		layer: entity, solid, vehicle
		mask: world
		exclude: tree
		flags: none
		dirty_flags: none
	}
}

health:
{
	max: 36000.000
}

damage.effects:
{
	threshold_wreck: 0.650
}

// armor:
// {
// 	toughness: 500.000
