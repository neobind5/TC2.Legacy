+slot.side.left|instance:
{
	joint.base:
	{
		offset_a: [-2.000, -0.250]
		max_force: 1500000.000
		max_torque: 500000.000
		flags: no_wrap, attachment, control_read, control_write, force_facing
		z: -60.000

		max_stress: 3.000
		stress_threshold: 2.500
		material_type: wood
	}

	joint.pivot:
	{
		error_bias: 0.010
		max_bias: 30.000
	}

	joint.gear:
	{
		rotation: 0.000
		min: -1.700
		max: 1.000
		flags: normalize_angle, normalize_limit, use_min_max, use_transform, use_sign_parent
		ratio: 1.000
		step: 10.000
		error_bias: 0.010
		max_bias: 2.000
		max_bias_bounce: 2.000
		max_torque: 0.000
		bounce: 1.000
		j_mult_a: 1.000
		j_mult_b: 1.000
		modifier: 1.000
		stress_mult: 1.000
	}

	attachment.slot:
	{
		name: "Mount\nLeft"
		identifier: "side.left"

		flags: keyboard_write, mouse_write
		flags_editable: use_center_of_gravity, locked, disabled, keyboard_read, keyboard_write, mouse_read, mouse_write, rotation, loose

		gui_size: [144.000, 160.000]
		rank: -5.000
	}
}

+slot.side.right|instance:
{
	joint.base:
	{
		offset_a: [2.000, -0.250]
		max_force: 1500000.000
		max_torque: 500000.000
		flags: no_wrap, attachment, control_read, control_write, force_facing, mirror_x
		z: -60.000

		max_stress: 3.000
		stress_threshold: 2.500
		material_type: wood
	}

	joint.pivot:
	{
		error_bias: 0.010
		max_bias: 30.000
	}

	joint.gear:
	{
		rotation: 0.000
		min: -1.700
		max: 1.000
		flags: normalize_angle, normalize_limit, use_min_max, use_transform, use_sign_parent
		ratio: 1.000
		step: 10.000
		error_bias: 0.010
		max_bias: 2.000
		max_bias_bounce: 2.000
		max_torque: 0.000
		bounce: 1.000
		j_mult_a: 1.000
		j_mult_b: 1.000
		modifier: 1.000
		stress_mult: 1.000
	}

	attachment.slot:
	{
		name: "Mount\nRight"
		identifier: "side.right"

		flags: keyboard_write, mouse_write
		flags_editable: use_center_of_gravity, locked, disabled, keyboard_read, keyboard_write, mouse_read, mouse_write, rotation, loose

		gui_size: [144.000, 160.000]
		rank: 5.000
	}
}

+slot.mid|instance:
{
	joint.base:
	{
		offset_a: [0.000, -0.250]
		max_force: 10000000.000
		max_torque: 200000.000
		flags: control_write, control_read, no_wrap, force_facing, attachment, use_proxy_body
		z: -50.000
	}

	joint.pivot:
	{
		error_bias: 0.01
		max_bias: 100.000
	}

	joint.gear:
	{
		error_bias: 0.01
		max_bias: 2.000
		min: 0.000
		max: 0.000
	}

	attachment.slot:
	{
		flags: keyboard_write, mouse_write
		flags_editable: use_center_of_gravity, locked, disabled, keyboard_read, keyboard_write, mouse_read, mouse_write, offset, rotation

		offset_bounds: [-1.000, -1.000, 1.000, 1.000]
		
		rank: -1.000
		
		gui_size: [144.000, 160.000]
		
		identifier: "mid"
		name:
			'''
			Rotary Mount
			Mid
			'''
	}
}