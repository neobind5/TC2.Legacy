$name: "Fancy Mine"
$desc:
	'''
	Mine that gradually produces ores and minerals.
	'''
$tags: []

body:
{
	type: static
	
	@shape.polygon:
	{
		points:
		[
			[-2.875, -0.400]
			[2.875, -0.400]
			[2.875, 2.000]
			[-2.875, 2.000]
		]
		
		mass: 6000.000
		radius: 1.000
		friction: 0.850
		
		material: building_masonry
		
		layer: entity, building, support, ignore_melee, ignore_bullet, storage
		mask: world, building
	}
}

animated.renderer:
{
	sprite:
	{
		texture: "fancymine"
		mask: "fancymine.mask"
	}
	z: -100.000
}

transform:
{

}

interactable:
{
	flags: no_tab
	priority: 1.000
	window_size: [144, 144]
	window_size_misc: [288.000, 144.000]
}

faction.colorable:
{

}

building:
{

}

nameable:
{
	flags: no_rename, randomize
}

faction:
{

}

claimable:
{
	flags: no_menu, enable_wololo
}

spawn:
{
	flags: faction, public
}

minimap.marker:
{
	sprite:
	{
		texture: "ui_icons_minimap"
		size: [16, 16]
		frame: [6, 0]
	}

	flags: faction, spawner
}

resourcegenerator8:
{
	produce_interval: 10.000
	efficiency:0.075

	items:
	[
		{
			material: stone
			chance: 100.000
			min: 5.000
			max: 12.000
		}
		{
			material: soil
			chance: 100.000
			min: 9.000
			max: 11.000
		}
		{
			material: copper
			chance: 100.000
			min: 1.000
			max: 2.500
		}
		{
			material: niklajzner
			chance: 100.000
			min: 0.800
			max: 1.100
		}
	]

	@inventory8:
	{
		type: output
		flags: standalone, allow_ducts, ignore_mass, public
		stack_size_multiplier: 1.000
		offset: [-1.750, 0.625]
	}
}

