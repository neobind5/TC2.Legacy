$name: "Unsorted Supplies"
$desc:
	'''
	TODO: Desc
	'''
$tags: []

body:
{
	buoyancy: 0.600
	fall_damage_multiplier: 1.200
	inventory_weight_multiplier: 0.750

	@shape.polygon:
	{
		points:
		[
			[-1.000, -0.875]
			[0.750, -0.625]
			[1.125, 0.875]
			[-1.125, 0.875]
		]
		
		mass: 55.000
		radius: 0.250
		friction: 0.450
		elasticity: 0.100
		
		material: machine
		
		layer: entity, solid, crate, storage, ignore_bullet, ignore_melee
		exclude: held, attached
	}

	@shape.line:
	{
		a: [-1.125, 1.125]
		b: [1.125, 1.125]
		
		mass: 30.000
		radius: 0.300
		friction: 0.950
		elasticity: 0.400
		
		material: wood
		
		layer: entity, solid, crate, platform, ignore_bullet, ignore_melee, ignore_hover, flammable
		exclude: held, attached
		// mask: solid

		flags: no_body_overrides, no_inventory_mass
	}
}

transform:
{

}

health:
{
	max: 15000.000
}

interactable:
{
	flags: centered_inventory, no_tab
	priority: 1.100
	window_size: [192.000, 192.000]
	window_size_misc: [96.000, 0.000]
}

animated.renderer:
{
	sprite:
	{
		texture: atlas.supplies.00
		size: [24, 24]
		frame: [4, 0]
	}
	z: -130.000
}

holdable:
{
	force_multiplier: 1.500
	torque_multiplier: 0.500
	stress_multiplier: 0.100
	radius: 0.000
	hints: materials, heavy, storage
	flags: disable_parent_facing, disable_rotation, disable_control, force_edge_pickup
	priority: -40.000
}

// attachment:
// {
// 	force_multiplier: 1.000
// 	torque_multiplier: 4.000
// 	offset: [0.000, 1.500]
// 	flags: none
// 	tags: large, fixed
// }

norotate:
{
	rotation: 0.000
	bias: 0.000
	speed: 2.000
	multiplier: 4.000
	mass_multiplier: 3.000
	flags: no_share, disable_attached
}

storage:
{
	@loot.container:
	{
		rolls: 9
		rolls_extra: 5
		rarity_min: 0.000
		rarity_max: 4.000
		merge_flags: skip_prefabs
		flags: no_duplicates, shuffle_inventory

		tables:
		[
			chemicals.00
			food.00
			military.00
			construction.00
		]
	}

	@inventory16:
	{
		type: storage
		flags: public, no_auto_pickup
		stack_size_multiplier: 8.000
		
		offset: [0.000, 0.000]
	}
}

claimable:
{
	flags: allow_enemy_unclaim, allow_owner_unclaim
}
faction:
{
}