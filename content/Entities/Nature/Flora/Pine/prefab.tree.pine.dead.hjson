$name: "Pine Tree (Dead)"
$desc: "A dead tree. Seems like a good source of wood."
$tags: []

body:
{
	type: static
	buoyancy: 0.800
	
	@shape.line:
	{
		a: [0.000, -10.500]
		b: [0.000, -0.250]
		mass: 1140.000
		radius: 0.500
		friction: 0.920
		elasticity: 0.210

		material: tree
		miss_chance: 0.928
		
		layer: entity, plant, organic, flammable, ignore_melee, ignore_bullet, no_overlapped_placement, tree
		mask: world, building, tree, no_overlapped_placement
		exclude: held
	}
}

transform:
{

}

health:
{
	max: 3000.000
}

