//	}
//	sound_split: "tree_snap_00"
//}

holdable:
{
	radius: 0.000
	force_multiplier: 3.000
	torque_multiplier: 2.000
	flags: disable_parent_facing, disable_rotation, full_rotate
}

animated.renderer:
{
	sprite:
	{
		texture: "tree.pine.00"
	}
	offset: [0.000, -5.500]
	z: -80.000
}

tree:
{
	sound_cut: "tree_fall"
}

harvestable:
{
	resources:
	[
		{
			material: wood
			quantity: 100
		}
		{
			material: seed.pine
			quantity: 2
		}
		{
			material: resin
			quantity: 10
		}
	]
	
	thresholds: [0.990, 0, 0.835, 0.441]
	
	pct_damage_mult: [0.952, 1, 0.859, 0.390]
	pct_quantity_min: [0.040, 1, 0.060, 0.160]
	
	chance_base: [0.184, 1, 0.239, 0.114]
}