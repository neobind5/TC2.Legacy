$name: "Pine Tree"
$desc: "A tree. Seems like a good source of wood."
$tags: []

body:
{
	type: static
	buoyancy: 0.800
	
	@shape.line:
	{
		a: [0.000, -10.500]
		b: [0.000, -0.250]
		mass: 1420.000
		radius: 0.500
		friction: 0.950
		elasticity: 0.310

		material: tree
		miss_chance: 0.928
		
		layer: entity, plant, organic, flammable, ignore_melee, ignore_bullet, no_overlapped_placement, tree
		mask: world, building, tree, no_overlapped_placement
		exclude: held
	}
}

transform:
{

}

health:
{
	max: 3800
}

//splittable:
//{
//	split_health: 0.2
//	rect: [-0.500, -10.500, 0.500, -0.250]
//	sprite_stub:
//	{
//		texture: "tree.stubs.00"
//		size: [16, 8]
//		frame: [1, 0]
//	}
//	sound_split: "tree_snap_00"
//}

holdable:
{
	radius: 0.000
	force_multiplier: 3.000
	torque_multiplier: 2.000
	flags: disable_parent_facing, disable_rotation, full_rotate
}

animated.renderer:
{
	sprite:
	{
		texture: "tree.pine.00"
	}
	offset: [0.000, -5.500]
	z: -80.000
}

tree:
{
	sound_cut: "tree_fall"
	
	@foliage.renderer:
	{
		offset: [-0, -9.000]
		z: -8.000
		
		sprite:
		{
			texture: "tree.pine.00.foliage"
			mask: "tree.pine.00.foliage.mask"
		}
	}
}

harvestable:
{
	resources:
	[
		{
			material: wood
			quantity: 120
		}
		{
			material: seed.pine
			quantity: 2
		}
		{
			material: plants
			quantity: 60
		}
		{
			material: resin
			quantity: 25
		}
		null
	]
	
	thresholds: [0.980, 0, 0.892, 0.947]
	
	pct_damage_mult: [0.952, 1, 0.859, 0.000]
	pct_quantity_min: [0.035, 1, 0.060, 0.000]
	
	chance_base: [0.086, 1, 0.173, 0.000]
}