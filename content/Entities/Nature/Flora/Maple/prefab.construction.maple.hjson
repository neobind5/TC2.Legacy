$name: "Maple Tree"
$desc:
	'''
	A young tree taking shape. Grows remarkably fast.
	'''
$tags: []

body:
{
	type: static
	buoyancy: 0.730
	
	@shape.line:
	{
		a: [0.000, -6.000]
		b: [0.000, 0.000]
		mass: 820.000
		radius: 0.375
		friction: 0.660
		elasticity: 0.240

		material: tree
		miss_chance: 0.972
		
		layer: entity, plant, organic, flammable, ignore_melee, ignore_bullet, no_overlapped_placement, tree
		mask: world, building, tree, no_overlapped_placement
		exclude: held
	}
}

health:
{
	max: 600.000
}

animated.renderer:
{
	offset: [0.000, -0.600]
	sprite:
	{
		texture: resource.seed.maple
		count: 4
		size: [16, 16]
		offset: [0,-15]
	}
	z: -300.000
}

transform:
{

}

crop:
{
	time_seconds: 90
	time_extra: 2
	prefab: "tree.maple"
}