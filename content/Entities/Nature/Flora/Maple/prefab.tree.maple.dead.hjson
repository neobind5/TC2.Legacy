$name: "Maple Tree (Dead)"
$desc: "A dead maple tree. Seems like a good source of wood."
$tags: []

body:
{
	type: static
	buoyancy: 0.730
	
	@shape.line:
	{
		a: [0.000, -6.000]
		b: [0.000, 0.000]
		
		mass: 820.000
		radius: 0.375
		friction: 0.660
		elasticity: 0.240

		material: tree
		miss_chance: 0.972
		
		layer: entity, plant, organic, flammable, ignore_melee, ignore_bullet, no_overlapped_placement, tree
		mask: world, building, tree, no_overlapped_placement
		exclude: held
	}
}

transform:
{

}

health:
{
	max: 2100.000
}

